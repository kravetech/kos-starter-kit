{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "capabilities",
  "type": "object",
  "required": [
    "schemaVersion",
    "capabilities"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "version",
          "paths"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    }
  },
  "additionalProperties": true
}
